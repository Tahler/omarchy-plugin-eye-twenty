{
  "schemaVersion": 1,
  "id": "io.github.tahler.eye-twenty",
  "name": "20-20-20 Eye Breaks",
  "version": "1.0.0",
  "license": "MIT",
  "author": "tahler",
  "description": "Sends a notification every 20 minutes reminder to look at an object 20 feet away for 20 seconds",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "20-20-20 Eye Breaks",
    "description": "Pause or resume 20-20-20 eye-break reminders",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
